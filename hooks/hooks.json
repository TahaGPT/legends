{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/optional-hooks.js\" pre-bash"
          }
        ],
        "description": "Opt-in (LEGENDS_HOOKS=tmux,push-reminder): block dev servers outside tmux, tmux and push reminders"
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/optional-hooks.js\" pre-write"
          }
        ],
        "description": "Opt-in (LEGENDS_HOOKS=block-md): block stray .md/.txt files"
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/suggest-compact.js\""
          }
        ],
        "description": "Suggest a manual /compact at logical intervals (COMPACT_THRESHOLD, default 50 edits)"
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/pre-compact.js\""
          }
        ],
        "description": "Log compaction events (prints nothing, so the compaction summary is unaffected)"
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/session-start.js\""
          }
        ],
        "description": "Tell Claude where the last session in this project left off; package-manager hint in JS projects"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/optional-hooks.js\" post-bash"
          }
        ],
        "description": "Print the PR URL and a review command after gh pr create"
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/optional-hooks.js\" post-edit"
          }
        ],
        "description": "Opt-in (LEGENDS_HOOKS=prettier,typecheck,console-log): format, type-check, and console.log warnings for edited files"
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/optional-hooks.js\" stop"
          }
        ],
        "description": "Opt-in (LEGENDS_HOOKS=console-log): console.log check across modified files"
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/session-end.js\""
          }
        ],
        "description": "Save a per-session record (project, branch, last request, uncommitted files, learning-review hint) for the next session"
      }
    ]
  }
}
